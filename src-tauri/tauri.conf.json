{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Server Command Center",
  "version": "1.0.0",
  "identifier": "com.falahtech.servercommandcenter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Server Command Center",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Falah Tech",
    "copyright": "Copyright © 2026 Falah Tech (falah-tech.com)",
    "category": "DeveloperTool",
    "shortDescription": "Fast, lightweight multi-server management and command center powered by Falah Tech.",
    "longDescription": "Server Command Center powered by Falah Tech (falah-tech.com) is a native desktop and mobile engineering cockpit for DevOps and system administrators to monitor server health, manage PM2 processes, trigger zero-downtime rebuild pipelines, stream logs, and access secure SSH terminals.",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
